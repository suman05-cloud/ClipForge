# Optional local settings. Copy to .env, then restart start.ps1.
# Lines are literal KEY=value strings; PowerShell expressions are not evaluated.
# Omit values to keep defaults. Relative data paths resolve from the project root.

# CLIPFORGE_DATA_DIR=E:\MyVideos\clipforge-data
# CLIPFORGE_MAX_UPLOAD_MB=2048
# CLIPFORGE_FFMPEG=C:\tools\ffmpeg\bin\ffmpeg.exe
# CLIPFORGE_FFPROBE=C:\tools\ffmpeg\bin\ffprobe.exe
# Only a loopback Ollama endpoint is supported; remote cloud endpoints are not enabled.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional web context for AI clip selection. Used only when you enable web research.
# TAVILY_API_KEY=tvly-your-key-here
# Optional additional CUDA 12 / cuDNN 9 DLL directories, separated by semicolons.
# Usually detected automatically after running setup-gpu.ps1.
# WHISPER_CUDA_PATH=C:\tools\cuda\bin;C:\tools\cudnn\bin

# Choose Ollama/Whisper models in the app. Default Ollama: qwen3.5:9b.
